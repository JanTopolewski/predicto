generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// UŻYTKOWNICY
// ============================================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitionMembers              CompetitionMember[]
  seasonWinnerPredictions         SeasonWinnerPrediction[]
  footballPredictions             FootballPrediction[]
  racingPredictions               RacingPrediction[]
  footballSeasonWinnerPredictions FootballSeasonWinnerPrediction[]

  @@index([username])
  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

// ============================================================================
// KONKURENCJE (SEASON/TURNIEJ/LIGA)
// ============================================================================

model Competition {
  id             String          @id @default(cuid())
  type           CompetitionType
  name           String
  season         String
  inviteCode     String          @unique
  isPublic       Boolean         @default(true)
  createdBy      String
  createdAt      DateTime        @default(now())
  startDate      DateTime
  endDate        DateTime
  winnerResolved Boolean         @default(false)
  updatedAt      DateTime        @updatedAt

  members                 CompetitionMember[]
  seasonWinnerPredictions SeasonWinnerPrediction[]
  footballSeasons         FootballSeason[]
  racingSeasons           RacingSeason[]
  scoringRules            CompetitionScoring?

  @@index([type])
  @@index([season])
  @@index([createdBy])
  @@index([inviteCode])
}

enum CompetitionType {
  FOOTBALL
  RACING
}

// ============================================================================
// CZŁONKOWIE KONKURENCJI (WCZEŚNIEJ LEAGUEMEMBER)
// ============================================================================

model CompetitionMember {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  joinedAt      DateTime @default(now())
  points        Int      @default(0)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([userId])
}

// ============================================================================
// REGUŁY PUNKTACJI
// ============================================================================

model CompetitionScoring {
  id                 String   @id @default(cuid())
  competitionId      String   @unique
  exactScorePoints   Int      @default(3)
  winnerPoints       Int      @default(1)
  seasonWinnerPoints Int      @default(10)
  podiumExactPoints  Int      @default(3)
  podiumAnyPoints    Int      @default(1)
  polePositionPoints Int      @default(2)
  wildcardPoints     Int      @default(2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

// ============================================================================
// TYPY ZWYCIĘZCY SEZONU
// ============================================================================

model SeasonWinnerPrediction {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  winnerId      String // TeamId dla FOOTBALL, DriverId dla RACING
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([userId])
  @@index([winnerId])
}

// ============================================================================
// PIŁKA NOŻNA
// ============================================================================

model FootballSeason {
  id              String   @id @default(cuid())
  competitionId   String
  createdAt       DateTime @default(now())
  hasMatchStarted Boolean  @default(false)

  competition             Competition                      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches                 FootballMatch[]
  seasonWinnerPredictions FootballSeasonWinnerPrediction[]

  @@index([competitionId])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeMatches             FootballMatch[]                  @relation("homeTeam")
  awayMatches             FootballMatch[]                  @relation("awayTeam")
  seasonWinnerPredictions FootballSeasonWinnerPrediction[]

  @@index([name])
}

model FootballMatch {
  id               String      @id @default(cuid())
  seasonId         String
  homeTeamId       String
  awayTeamId       String
  kickoff          DateTime
  status           MatchStatus @default(SCHEDULED)
  homeGoals        Int?
  awayGoals        Int?
  resolved         Boolean     @default(false)
  votingClosedAt   DateTime?
  predictedEndTime DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  season      FootballSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam    Team                 @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team                 @relation("awayTeam", fields: [awayTeamId], references: [id])
  predictions FootballPrediction[]
  auditLogs   AuditLog[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([kickoff])
  @@index([status])
}

model FootballSeasonWinnerPrediction {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season FootballSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team           @relation(fields: [teamId], references: [id])

  @@unique([seasonId, userId])
  @@index([seasonId])
  @@index([userId])
  @@index([teamId])
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  POSTPONED
  CANCELLED
}

model FootballPrediction {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  homeGoals Int
  awayGoals Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match FootballMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

// ============================================================================
// FORMULA 1
// ============================================================================

model RacingSeason {
  id            String   @id @default(cuid())
  competitionId String
  createdAt     DateTime @default(now())

  competition Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  weekends    RacingWeekend[]

  @@index([competitionId])
}

model Driver {
  id        String   @id @default(cuid())
  name      String   @unique
  number    Int      @unique
  team      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  racingResults     RacingResult[]
  racingPredictions RacingPrediction[]
  wildcards         Wildcard[]

  @@index([number])
}

model RacingWeekend {
  id        String   @id @default(cuid())
  seasonId  String
  grandPrix String
  country   String
  raceDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season    RacingSeason    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sessions  RacingSession[]
  wildcards Wildcard[]

  @@index([seasonId])
  @@index([raceDate])
}

model RacingSession {
  id        String            @id @default(cuid())
  weekendId String
  type      RacingSessionType
  startTime DateTime
  resolved  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  weekend     RacingWeekend      @relation(fields: [weekendId], references: [id], onDelete: Cascade)
  results     RacingResult[]
  predictions RacingPrediction[]
  wildcards   Wildcard[]
  auditLogs   AuditLog[]

  @@index([weekendId])
  @@index([type])
  @@index([startTime])
}

enum RacingSessionType {
  PRACTICE1
  PRACTICE2
  PRACTICE3
  QUALIFYING
  SPRINT
  RACE
}

model RacingResult {
  id        String   @id @default(cuid())
  sessionId String
  driverId  String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session RacingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver  Driver        @relation(fields: [driverId], references: [id])

  @@unique([sessionId, driverId])
  @@index([sessionId])
  @@index([driverId])
}

model RacingPrediction {
  id                 String   @id @default(cuid())
  sessionId          String
  userId             String
  firstDriver        String // DriverId
  secondDriver       String // DriverId
  thirdDriver        String // DriverId
  polePosition       String? // DriverId (opcjonalne)
  wildcardPrediction Int? // pozycja dla wildcard kierowcy
  points             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session  RacingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Driver   Driver?       @relation(fields: [driverId], references: [id])
  driverId String?

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Wildcard {
  id        String   @id @default(cuid())
  sessionId String?
  weekendId String?
  driverId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session RacingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  weekend RacingWeekend? @relation(fields: [weekendId], references: [id], onDelete: Cascade)
  driver  Driver         @relation(fields: [driverId], references: [id])

  @@index([sessionId])
  @@index([weekendId])
  @@index([driverId])
}

// ============================================================================
// AUDIT LOGS (dla zmian dokonanych przez admina)
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String // "UPDATE_MATCH_RESULT", "UPDATE_SESSION_RESULT", etc.
  adminId    String
  entityType String // "FootballMatch", "F1Session"
  entityId   String
  oldValues  String? // JSON
  newValues  String? // JSON
  createdAt  DateTime @default(now())

  match           FootballMatch? @relation(fields: [footballMatchId], references: [id], onDelete: SetNull)
  session         RacingSession? @relation(fields: [racingSessionId], references: [id], onDelete: SetNull)
  footballMatchId String?
  racingSessionId String?

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
}
