# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/predicto?schema=public

# NextAuth session encryption key (generate with: npx auth secret)
NEXTAUTH_SECRET=
# Application base URL (e.g. http://localhost:3000)
NEXTAUTH_URL=

# Web Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Bearer token to protect cron endpoints (/api/cron/*)
CRON_SECRET=

# Initial admin account created via `npx prisma db seed`
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=